# ---- LLM provider (LLMod.ai — OpenAI-compatible) ----
# Copy the base URL and model id from the LLMod.ai dashboard.
LLM_BASE_URL=https://api.llmod.ai/v1
LLM_API_KEY=
LLM_MODEL=
# Alias LLM_EMBEDDING_MODEL is also accepted.
LLM_EMBED_MODEL=
LLM_TIMEOUT_SECONDS=120
# Retrieval falls back to local TF-IDF if the query embedding is slow or unavailable.
EMBED_TIMEOUT_SECONDS=20
# Bound vector queries so retrieval cannot consume Vercel's whole request window.
PINECONE_TIMEOUT_SECONDS=20
# Applies to each Supabase PostgREST request, including best-effort run logging.
SUPABASE_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=6000
# Retry ceiling when reasoning tokens exhaust the output budget.
LLM_MAX_OUTPUT_TOKENS_CEILING=16000
# minimal | low | medium | high (reasoning models only); blank omits the parameter.
LLM_REASONING_EFFORT=low
# Leave BLANK for reasoning models such as gpt-5-mini: they accept only
# temperature=1 and reject any other value, so the parameter is omitted entirely
# unless you set a number here.
LLM_TEMPERATURE=

# ---- Pinecone (festival identity embeddings) ----
PINECONE_API_KEY=
PINECONE_INDEX=the-distributor
PINECONE_NAMESPACE=festivals
# "llm" = embed with LLM_EMBED_MODEL (LLMod.ai); "pinecone" = Pinecone hosted inference.
EMBED_PROVIDER=llm
# Only read when EMBED_PROVIDER=pinecone; ignored otherwise.
PINECONE_EMBED_MODEL=multilingual-e5-large

# ---- Supabase (festival facts, company memory, run logs, campaign state) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Existing maintenance/seed scripts use this legacy name.
SUPABASE_SERVICE_KEY=
# Campaign Workspace requires a server-only service-role credential and fails
# closed without it. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Exact comma-separated HTTP(S) origins allowed to make workspace JSON writes.
# Add the deployed Vercel origin; wildcards and Origin: null are rejected.
CAMPAIGN_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
COMPANY_ID=meridian-films

# ---- Agent tuning ----
CANDIDATE_POOL_SIZE=12
MAX_REPLAN_ROUNDS=1
# Protect the public no-auth endpoint from accidentally enormous prompts.
MAX_PROMPT_CHARS=12000
# Hard end-to-end budget, leaving 40 seconds below Vercel's 300-second ceiling.
RUN_DEADLINE_SECONDS=260
# A revision is skipped past this point so a run stays inside the 300s limit.
REVISION_DEADLINE_SECONDS=150
