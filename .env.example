# ---- LLM provider (LLMod.ai — OpenAI-compatible) ----
# Copy the base URL and model id from the LLMod.ai dashboard.
LLM_BASE_URL=https://api.llmod.ai/v1
LLM_API_KEY=
LLM_MODEL=
LLM_EMBED_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=2000

# ---- Pinecone (festival identity embeddings) ----
PINECONE_API_KEY=
PINECONE_INDEX=the-distributor
PINECONE_NAMESPACE=festivals
# "llm" = embed with LLM_EMBED_MODEL (LLMod.ai); "pinecone" = Pinecone hosted inference.
EMBED_PROVIDER=llm
PINECONE_EMBED_MODEL=multilingual-e5-large

# ---- Supabase (festival facts, company memory, run logs) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service key is only needed locally for seeding; do not set it in Vercel.
SUPABASE_SERVICE_KEY=
COMPANY_ID=meridian-films

# ---- Agent tuning ----
CANDIDATE_POOL_SIZE=16
MAX_REPLAN_ROUNDS=1
