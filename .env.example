# ---- LLM provider (LLMod.ai — OpenAI-compatible) ----
# Copy the base URL and model id from the LLMod.ai dashboard.
LLM_BASE_URL=https://api.llmod.ai/v1
LLM_API_KEY=
LLM_MODEL=
# Alias LLM_EMBEDDING_MODEL is also accepted.
LLM_EMBED_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=6000
# Retry ceiling when reasoning tokens exhaust the output budget.
LLM_MAX_OUTPUT_TOKENS_CEILING=16000
# minimal | low | medium | high (reasoning models only); blank omits the parameter.
LLM_REASONING_EFFORT=low
# Leave BLANK for reasoning models such as gpt-5-mini: they accept only
# temperature=1 and reject any other value, so the parameter is omitted entirely
# unless you set a number here.
LLM_TEMPERATURE=

# ---- Pinecone (festival identity embeddings) ----
PINECONE_API_KEY=
PINECONE_INDEX=the-distributor
PINECONE_NAMESPACE=festivals
# "llm" = embed with LLM_EMBED_MODEL (LLMod.ai); "pinecone" = Pinecone hosted inference.
EMBED_PROVIDER=llm
# Only read when EMBED_PROVIDER=pinecone; ignored otherwise.
PINECONE_EMBED_MODEL=multilingual-e5-large

# ---- Supabase (festival facts, company memory, run logs) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service key is only needed locally for seeding; do not set it in Vercel.
SUPABASE_SERVICE_KEY=
COMPANY_ID=meridian-films

# ---- Agent tuning ----
CANDIDATE_POOL_SIZE=12
MAX_REPLAN_ROUNDS=1
# A revision is skipped past this point so a run stays inside the 300s limit.
REVISION_DEADLINE_SECONDS=150
